#include "SampleCode.xcconfig"

SERVER_BASE_URL = http:\/\/YOUR_SERVER_IP:8000
TRIPO_API_KEY = YOUR_TRIPO_API_KEY
MESHY_API_KEY = YOUR_MESHY_API_KEY
